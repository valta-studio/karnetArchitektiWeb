---
// Menu obrazovka — poloprůhledný overlay se stejným obsahem na všech
// šířkách (kompletní navigace + sociální sítě). Ve scroll toku není —
// otevírá ji burger nad aktuální úrovní (menu.ts přepíná html.menu-open).
import { NAV_LINKS } from '../lib/nav';
import type { Contact } from '../types/sanity';

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;

const menuLinks = NAV_LINKS;
---

<section class="level burger-screen" data-level="menu" id="menu">
  <nav class="burger-nav" aria-label="Menu">
    <ul>
      {
        menuLinks.map((link) => (
          <li>
            <a href={link.href} data-scroll-to={link.id}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    contact.socialLinks?.length ? (
      <ul class="burger-socials">
        {contact.socialLinks.map((social) => (
          <li>
            <a href={social.url} rel="noopener" target="_blank">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    ) : null
  }
</section>

<!-- Vzorkovací proužky pro lišty Safari 26 (iOS 26): prohlížeč tónuje
     lišty podle background-color fixed/sticky elementů u hran viewportu
     (theme-color metu ignoruje, menu.ts). Vzorkuje i opacity: 0, takže
     proužky nejsou nikdy vidět; display: none se nevzorkuje, takže
     existují jen s otevřeným menu — zavřené menu vrací lišty k podkladu
     body. Spodní lišta se tónuje jen s viewport-fit=cover (Base.astro). -->
<div class="bar-tint bar-tint-top" aria-hidden="true"></div>
<div class="bar-tint bar-tint-bottom" aria-hidden="true"></div>

<style>
  .burger-screen {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100dvh;
    padding: calc(var(--header-height) + var(--space-lg)) var(--page-pad)
      var(--space-lg);
    background: color-mix(in srgb, var(--color-overlay) 90%, transparent);
    color: var(--color-text);
  }

  /* položky vodorovně na středu (osa loga na desktopu) */
  .burger-nav ul,
  .burger-socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Položky ve velikosti loga (--text-xl, Header) — velká polotučná
     typografie */
  .burger-nav a,
  .burger-socials a {
    display: block;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    font-weight: var(--weight-heavy);
    letter-spacing: -0.02em;
  }

  /* Obrazovka není ve scroll toku — je fixed overlay nad aktuální
     úrovní, otevírá se burgerem. Stránka pod ním zůstává, kde byla.
     Zavřená je display: none, NE visibility: hidden: Safari 26 (iOS 26)
     tónuje lišty vzorkováním fixed elementů u hran viewportu a vzorkuje
     i visibility: hidden — skrytý overlay by lištu držel napořád.
     Fade zůstává přes transition display + allow-discrete; prohlížeče
     bez podpory menu jen přepnou bez prolnutí. */
  .burger-screen {
    position: fixed;
    inset: 0;
    z-index: 9; /* pod hlavičkou (10) — burger zůstává klikací pro zavření */
    overflow-y: auto;
    overscroll-behavior: contain;
    display: none;
    opacity: 0;
    transition:
      opacity var(--duration) var(--ease),
      display var(--duration) allow-discrete;
  }

  :global(html.menu-open) .burger-screen {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    :global(html.menu-open) .burger-screen {
      opacity: 0;
    }
  }

  /* Geometrie dle pravidel vzorkování Safari: ≥80 % šířky viewportu,
     ≥3px výšky, horní hrana do 4px od vršku; dole smí přesahovat
     až bottom: -8px při min-height: 12px. */
  .bar-tint {
    display: none;
    position: fixed;
    left: 0;
    width: 100%;
    height: 12px;
    background-color: var(--color-overlay);
    opacity: 0;
    pointer-events: none;
  }

  .bar-tint-top {
    top: 0;
  }

  .bar-tint-bottom {
    bottom: -8px;
  }

  :global(html.menu-open) .bar-tint {
    display: block;
  }

  /* mobil: řádky menu stejně těsné jako dvouřádkové logo (line-height 1,
     Header.astro) */
  @media (max-width: 767px) {
    .burger-nav a,
    .burger-socials a {
      line-height: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger-screen {
      transition: none;
    }
  }
</style>
