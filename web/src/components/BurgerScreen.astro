---
// Menu obrazovka — poloprůhledný overlay se stejným obsahem na všech
// šířkách (navigace bez Intra + sociální sítě; Intro vede přes logo).
// Na desktopu je poslední snap úrovní: úroveň před ní je sticky
// (scroll.css), takže menu při doscrollování najede PŘES ni a ta jí
// prosvítá pozadím. Na mobilu ve scroll toku není — otevírá ji burger
// nad aktuální úrovní (menu.ts přepíná html.menu-open).
import { NAV_LINKS } from '../lib/nav';
import type { Contact } from '../types/sanity';

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;

// Intro v menu není (dle náhledu) — vede na něj logo v hlavičce
const menuLinks = NAV_LINKS.filter((link) => link.id !== 'uvod');
---

<section class="level burger-screen" data-level="menu" id="menu">
  <nav class="burger-nav" aria-label="Menu">
    <ul>
      {
        menuLinks.map((link) => (
          <li>
            <a href={link.href} data-scroll-to={link.id}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    contact.socialLinks?.length ? (
      <ul class="burger-socials">
        {contact.socialLinks.map((social) => (
          <li>
            <a href={social.url} rel="noopener" target="_blank">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    ) : null
  }
</section>

<style>
  .burger-screen {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100dvh;
    padding: calc(var(--header-height) + var(--space-lg)) var(--page-pad)
      var(--space-lg);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    color: var(--color-text);
  }

  .burger-nav ul,
  .burger-socials {
    display: flex;
    flex-direction: column;
    width: var(--content-text-width);
  }

  .burger-nav a,
  .burger-socials a {
    display: block;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
    font-weight: var(--weight-heavy);
  }

  /* Mobil: obrazovka není ve scroll toku — je fixed overlay nad aktuální
     úrovní, otevírá se burgerem. Stránka pod ním zůstává, kde byla. */
  @media (max-width: 767px) {
    .burger-screen {
      position: fixed;
      inset: 0;
      z-index: 9; /* pod hlavičkou (10) — burger zůstává klikací pro zavření */
      overflow-y: auto;
      overscroll-behavior: contain;
      visibility: hidden;
      opacity: 0;
      transition:
        opacity var(--duration) var(--ease),
        visibility 0s var(--duration);
    }

    :global(html.menu-open) .burger-screen {
      visibility: visible;
      opacity: 1;
      transition: opacity var(--duration) var(--ease);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger-screen {
      transition: none;
    }
  }
</style>
