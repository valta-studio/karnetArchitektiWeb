---
// Menu obrazovka — poloprůhledný overlay se stejným obsahem na všech
// šířkách (kompletní navigace + sociální sítě). Ve scroll toku není —
// otevírá ji burger nad aktuální úrovní (menu.ts přepíná html.menu-open).
import { NAV_LINKS } from '../lib/nav';
import type { Contact } from '../types/sanity';

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;

const menuLinks = NAV_LINKS;
---

<section class="level burger-screen" data-level="menu" id="menu">
  <nav class="burger-nav" aria-label="Menu">
    <ul>
      {
        menuLinks.map((link) => (
          <li>
            <a href={link.href} data-scroll-to={link.id}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    contact.socialLinks?.length ? (
      <ul class="burger-socials">
        {contact.socialLinks.map((social) => (
          <li>
            <a href={social.url} rel="noopener" target="_blank">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    ) : null
  }
</section>

<!-- Proužky pro lišty Safari 26 (iOS 26); theme-color metu Safari
     ignoruje (menu.ts). WebKit (LocalFrameView::fixedContainerEdges)
     udělá hit test 4px od horní/spodní hrany uprostřed viewportu a první
     fixed/sticky předek ≥ 90 % šířky je „kontejner" hrany. Má-li viditelný
     background-color, lišta ho převezme vždy čerstvě. Nemá-li (naše
     průhledná hlavička), barva se vezme ze snímku fixed vrstev a pro
     stejný kontejner se pak jen RECYKLUJE — proto lišta po zavření menu
     držela šedou. Proužky proto leží NAD hlavičkou (z-index 11), jsou
     na iOS zobrazené pořád a jen mění podklad: zavřené = podklad stránky,
     otevřené = podklad overlaye. Kontejnerem s viditelnou barvou jsou tak
     v obou stavech a WebKit nemá co recyklovat. Spodní lišta se tónuje
     jen s viewport-fit=cover (Base.astro). -->
<div class="bar-tint bar-tint-top" aria-hidden="true"></div>
<div class="bar-tint bar-tint-bottom" aria-hidden="true"></div>

<style>
  .burger-screen {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100dvh;
    padding: calc(var(--header-height) + var(--space-lg)) var(--page-pad)
      var(--space-lg);
    background: color-mix(in srgb, var(--color-overlay) 90%, transparent);
    color: var(--color-text);
  }

  /* položky vodorovně na středu (osa loga na desktopu) */
  .burger-nav ul,
  .burger-socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Položky ve velikosti loga (--text-xl, Header) — velká polotučná
     typografie, řádky stejně těsné jako dvouřádkové logo (line-height 1) */
  .burger-nav a,
  .burger-socials a {
    display: block;
    font-size: var(--text-xl);
    line-height: 1;
    font-weight: var(--weight-heavy);
    letter-spacing: -0.02em;
  }

  /* podtržení při hoveru přiléhá k písmu (global.css odsazuje 0.2em);
     bez skip-ink — čára by se u spodních hran verzálek přerušovala */
  .burger-nav a:hover,
  .burger-socials a:hover {
    text-underline-offset: 0;
    text-decoration-skip-ink: none;
  }

  /* Obrazovka není ve scroll toku — je fixed overlay nad aktuální
     úrovní, otevírá se burgerem. Stránka pod ním zůstává, kde byla.
     Zavřená je display: none, NE visibility: hidden: Safari 26 (iOS 26)
     tónuje lišty vzorkováním fixed elementů u hran viewportu a vzorkuje
     i visibility: hidden — skrytý overlay by lištu držel napořád.
     Fade zůstává přes transition display + allow-discrete; prohlížeče
     bez podpory menu jen přepnou bez prolnutí. */
  .burger-screen {
    position: fixed;
    inset: 0;
    z-index: 9; /* pod hlavičkou (10) — burger zůstává klikací pro zavření */
    overflow-y: auto;
    overscroll-behavior: contain;
    display: none;
    opacity: 0;
    transition:
      opacity var(--duration) var(--ease),
      display var(--duration) allow-discrete;
  }

  :global(html.menu-open) .burger-screen {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    :global(html.menu-open) .burger-screen {
      opacity: 0;
    }
  }

  /* Geometrie dle WebKitu: hit test 4px od hrany uprostřed → proužek
     leží na hraně a je vyšší než 10px („tenký okraj" se přeskakuje),
     šířka ≥ 90 % viewportu. Opacity/visibility se NESMÍ animovat ani
     snižovat (pod 0,1 přestává být kontejnerem). Podklad s alfou 0,9
     WebKit zaokrouhlí na plnou barvu (práh 0,75). */
  .bar-tint {
    --bar-tint-height: 12px;
    display: none;
    position: fixed;
    left: 0;
    width: 100%;
    height: var(--bar-tint-height);
    z-index: 11; /* nad hlavičkou (10): hit test musí trefit proužek */
    background-color: var(--color-bg);
    pointer-events: none;
  }

  .bar-tint-top {
    top: 0;
  }

  .bar-tint-bottom {
    bottom: 0;
  }

  :global(html.menu-open) .bar-tint {
    background-color: color-mix(in srgb, var(--color-overlay) 90%, transparent);
  }

  /* Jen iOS/iPadOS (WebKit s -webkit-touch-callout): jinde lišty takhle
     netónují a proužek by jen zakrýval 12px u hran. Zavřený proužek má
     barvu podkladu stránky — u hran žádný obsah není (hlavička má
     padding, úrovně mají obsah na středu), takže splývá. Otevřený overlay
     o výšku proužků ustupuje, jinak by u hran vznikl o 10 % tmavší pruh;
     odsazení obsahu se o totéž zmenší, takže sedí stejně. */
  @supports (-webkit-touch-callout: none) {
    .bar-tint {
      display: block;
    }

    .burger-screen {
      --bar-tint-height: 12px;
      inset: var(--bar-tint-height) 0;
      min-height: 0; /* ne 100dvh z .level — výšku dává inset */
      padding-top: calc(var(--header-height) + var(--space-lg) - var(--bar-tint-height));
      padding-bottom: calc(var(--space-lg) - var(--bar-tint-height));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .burger-screen {
      transition: none;
    }
  }
</style>
