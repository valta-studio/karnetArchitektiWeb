---
// Menu obrazovka — poloprůhledný overlay se stejným obsahem na všech
// šířkách (kompletní navigace + sociální sítě). Ve scroll toku není —
// otevírá ji burger nad aktuální úrovní (menu.ts přepíná html.menu-open).
import { NAV_LINKS } from '../lib/nav';
import type { Contact } from '../types/sanity';

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;

const menuLinks = NAV_LINKS;
---

<section class="level burger-screen" data-level="menu" id="menu">
  <nav class="burger-nav" aria-label="Menu">
    <ul>
      {
        menuLinks.map((link) => (
          <li>
            <a href={link.href} data-scroll-to={link.id}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    contact.socialLinks?.length ? (
      <ul class="burger-socials">
        {contact.socialLinks.map((social) => (
          <li>
            <a href={social.url} rel="noopener" target="_blank">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    ) : null
  }
</section>

<!-- Proužky pro lišty Safari 26 (iOS 26), theme-color metu Safari
     ignoruje (menu.ts). WebKit (LocalFrameView::fixedContainerEdges)
     udělá hit test 4px od horní/spodní hrany uprostřed viewportu a první
     fixed/sticky předek ≥ 90 % šířky je „kontejner" hrany: má-li viditelný
     background-color, lišta ho převezme. Nemá-li (naše hlavička je
     průhledná), barva se vzorkuje ze snímku fixed vrstev a pak se pro
     stejný kontejner už jen RECYKLUJE (Page::updateFixedContainerEdges) —
     proto lišta po zavření menu držela šedou: kontejnerem byla pořád
     hlavička. Proužky proto leží NAD hlavičkou (z-index 11), mají plnou
     neprůhlednost a viditelný podklad = s otevřeným menu jsou kontejnerem
     ony a barva je vždy čerstvá. Zavřené jsou display: none, čímž
     z kontejneru vypadnou (element bez rendereru WebKit zahodí) a lišta
     se vrátí k podkladu body. Spodní lišta se tónuje jen
     s viewport-fit=cover (Base.astro). -->
<div class="bar-tint bar-tint-top" aria-hidden="true"></div>
<div class="bar-tint bar-tint-bottom" aria-hidden="true"></div>

<style>
  /* Výška proužků .bar-tint (viz níže): overlay o ni u obou hran
     ustupuje, proužky mají stejný podklad — opticky jedna plocha. */
  .burger-screen,
  .bar-tint {
    --bar-tint-height: 12px;
    background: color-mix(in srgb, var(--color-overlay) 90%, transparent);
  }

  .burger-screen {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* obsah sedí stejně, jako by overlay začínal na hraně viewportu */
    padding: calc(var(--header-height) + var(--space-lg) - var(--bar-tint-height))
      var(--page-pad) calc(var(--space-lg) - var(--bar-tint-height));
    color: var(--color-text);
  }

  /* položky vodorovně na středu (osa loga na desktopu) */
  .burger-nav ul,
  .burger-socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Položky ve velikosti loga (--text-xl, Header) — velká polotučná
     typografie, řádky stejně těsné jako dvouřádkové logo (line-height 1) */
  .burger-nav a,
  .burger-socials a {
    display: block;
    font-size: var(--text-xl);
    line-height: 1;
    font-weight: var(--weight-heavy);
    letter-spacing: -0.02em;
  }

  /* Obrazovka není ve scroll toku — je fixed overlay nad aktuální
     úrovní, otevírá se burgerem. Stránka pod ním zůstává, kde byla.
     Zavřená je display: none, NE visibility: hidden: Safari 26 (iOS 26)
     tónuje lišty vzorkováním fixed elementů u hran viewportu a vzorkuje
     i visibility: hidden — skrytý overlay by lištu držel napořád.
     Fade zůstává přes transition display + allow-discrete; prohlížeče
     bez podpory menu jen přepnou bez prolnutí. */
  .burger-screen {
    position: fixed;
    /* u horní a spodní hrany ustupuje proužkům .bar-tint (ty jsou nad
       hlavičkou; kdyby se překrývaly, byl by pruh u hrany o 10 % tmavší) */
    inset: var(--bar-tint-height) 0;
    min-height: 0; /* ne 100dvh z .level — výšku dává inset */
    z-index: 9; /* pod hlavičkou (10) — burger zůstává klikací pro zavření */
    overflow-y: auto;
    overscroll-behavior: contain;
    display: none;
    opacity: 0;
    transition:
      opacity var(--duration) var(--ease),
      display var(--duration) allow-discrete;
  }

  :global(html.menu-open) .burger-screen {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    :global(html.menu-open) .burger-screen {
      opacity: 0;
    }
  }

  /* Geometrie dle WebKitu: hit test 4px od hrany uprostřed → proužek
     musí ležet na hraně a být vyšší než 10px („tenký okraj" se
     přeskakuje); šířka ≥ 90 % viewportu. Podklad s alfou 0,9 WebKit
     zaokrouhlí na plnou barvu (práh 0,75), lišta = --color-overlay.
     Opacity ani visibility se tu NESMÍ animovat: pod 0,1 proužek
     přestane být kontejnerem, hit test propadne na hlavičku a ta si
     mezibarvu prolínajícího overlaye zapamatuje napořád. */
  .bar-tint {
    display: none;
    position: fixed;
    left: 0;
    width: 100%;
    height: var(--bar-tint-height);
    z-index: 11; /* nad hlavičkou (10): hit test musí trefit proužek */
    pointer-events: none;
    /* Zavírá se až PO doběhnutí fade-outu overlaye: dokud overlay
       mizí, kontejnerem zůstává proužek; teprve pak hit test padne na
       hlavičku, snímek fixed vrstev je už prázdný a lišta se vrátí
       k podkladu body. Kdyby proužek zmizel dřív, hlavička by si ze
       snímku vzala zbytek prolínajícího overlaye. */
    transition: display calc(var(--duration) + 50ms) allow-discrete;
  }

  .bar-tint-top {
    top: 0;
  }

  .bar-tint-bottom {
    bottom: 0;
  }

  :global(html.menu-open) .bar-tint {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .burger-screen,
    .bar-tint {
      transition: none;
    }
  }
</style>
