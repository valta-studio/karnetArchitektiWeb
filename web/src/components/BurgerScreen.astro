---
// Menu obrazovka. Na desktopu poslední snap úroveň každé stránky
// (dosažitelná scrollem), na mobilu overlay přes aktuální úroveň
// otevíraný burgerem (menu.ts přepíná html.menu-open).
import { NAV_LINKS } from '../lib/nav';
import type { Contact } from '../types/sanity';

interface Props {
  contact: Contact;
  siteName: string;
}

const { contact, siteName } = Astro.props;
---

<section class="level burger-screen" data-level="menu" id="menu">
  <nav class="burger-nav" aria-label="Menu">
    <ul>
      {
        NAV_LINKS.map((link) => (
          <li class:list={{ 'nav-intro': link.id === 'uvod' }}>
            <a href={link.href} data-scroll-to={link.id}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="burger-footer">
    <div class="burger-contact">
      {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
      {
        contact.phone && (
          <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
        )
      }
    </div>

    {
      contact.socialLinks?.length ? (
        <ul class="burger-socials">
          {contact.socialLinks.map((social) => (
            <li>
              <a href={social.url} rel="noopener" target="_blank">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }

    <p class="burger-sitename">{siteName}</p>
  </div>
</section>

<style>
  .burger-screen {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100dvh;
    padding: calc(var(--header-height) + var(--space-lg)) var(--page-pad)
      var(--space-lg);
    background: var(--color-inverse-bg);
    color: var(--color-chrome);
  }

  .burger-nav ul {
    display: flex;
    flex-direction: column;
    width: var(--content-text-width);
  }

  .burger-nav a {
    display: block;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
    font-weight: var(--weight-heavy);
  }

  .burger-footer {
    display: flex;
    flex-direction: column;
    width: var(--content-text-width);
    gap: var(--space-md);
  }

  .burger-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .burger-socials {
    display: flex;
    gap: var(--space-md);
    opacity: 0.55;
  }

  .burger-sitename {
    font-size: var(--text-sm);
    opacity: 0.55;
  }

  /* Mobil: obrazovka není ve scroll toku — je fixed overlay nad aktuální
     úrovní, otevírá se burgerem. Stránka pod ním zůstává, kde byla a
     prosvítá poloprůhledným pozadím (dle náhledu). Obsah overlaye je jen
     navigace + sociální sítě velkou typografií; kontakt a název studia
     zůstávají desktopové menu úrovni. */
  @media (max-width: 767px) {
    .burger-screen {
      position: fixed;
      inset: 0;
      z-index: 9; /* pod hlavičkou (10) — burger zůstává klikací pro zavření */
      overflow-y: auto;
      overscroll-behavior: contain;
      background: color-mix(in srgb, var(--color-bg) 80%, transparent);
      color: var(--color-text);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity var(--duration) var(--ease),
        visibility 0s var(--duration);
    }

    :global(html.menu-open) .burger-screen {
      visibility: visible;
      opacity: 1;
      transition: opacity var(--duration) var(--ease);
    }

    /* Intro v overlayi není (dle náhledu) — vede na něj logo */
    .nav-intro {
      display: none;
    }

    /* jednotný obsahový text 17px (--text-body) jako zbytek webu;
       navigace ho dědí ze základního pravidla výš */
    .burger-socials a {
      font-size: var(--text-body);
      line-height: var(--leading-snug);
      font-weight: var(--weight-heavy);
    }

    .burger-contact,
    .burger-sitename {
      display: none;
    }

    .burger-socials {
      flex-direction: column;
      gap: 0;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger-screen {
      transition: none;
    }
  }
</style>
