---
// Jediná povolená cesta k obrázkům — srcset, WebP (auto=format), hotspot, lazy.
// V mock režimu (bez Sanity) renderuje lokální placeholder.
import { dimensionsFor, isMockImage, srcsetFor, urlFor } from '../lib/image';
import type { ImageSource } from '../types/sanity';

interface Props {
  image: ImageSource;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  maxWidth?: number;
  /** Šedý podklad, dokud se obrázek nestáhne (viz img-skeleton.ts). */
  skeleton?: boolean;
  /** Nejdřív vykreslit menší verzi (srcset do `maxWidth` se `sizes` jiného
   *  místa, typicky portfolia → z cache) a plnou kvalitu dotáhnout na pozadí
   *  po jejím načtení (viz img-upgrade.ts). */
  preview?: { sizes: string; maxWidth: number };
}

const {
  image,
  alt,
  sizes = '100vw',
  loading = 'lazy',
  class: className,
  maxWidth = 2560,
  skeleton = false,
  preview,
} = Astro.props;

const mock = isMockImage(image);
const dimensions = mock
  ? { width: image.width, height: image.height }
  : dimensionsFor(image);
const fullSrcset = mock ? undefined : srcsetFor(image, maxWidth);
const previewSrcset = mock || !preview ? undefined : srcsetFor(image, preview.maxWidth);
---

{
  mock ? (
    <img
      src={image.src}
      width={dimensions.width}
      height={dimensions.height}
      alt={alt}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      decoding="async"
      class={className}
      data-skeleton={skeleton || undefined}
    />
  ) : (
    <img
      src={urlFor(image).width(1080).url()}
      srcset={previewSrcset ?? fullSrcset}
      sizes={preview?.sizes ?? sizes}
      data-full-srcset={preview ? fullSrcset : undefined}
      data-full-sizes={preview ? sizes : undefined}
      width={dimensions.width}
      height={dimensions.height}
      alt={alt}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      decoding="async"
      class={className}
      data-skeleton={skeleton || undefined}
    />
  )
}
