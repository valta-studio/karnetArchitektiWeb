---
// Tečkový indikátor pozice na horizontální dráze (dole uprostřed).
// Aktivní tečku přepíná scroll-engine.ts podle pozice dráhy.
interface Props {
  rowId: string;
  count: number;
  class?: string;
}

const { rowId, count, class: className } = Astro.props;
---

{/* box je v DOM i pro jediný panel (hidden): stránkování textu
    (scroll-engine) může panely přidat až po layoutu a tečky si do boxu
    přestaví — i odkrýt */}
<div
  class:list={['progress-dots', className]}
  data-dots-for={rowId}
  role="group"
  aria-label="Posun v obsahu"
  hidden={count < 2 || undefined}
>
  {
    count > 1 &&
      Array.from({ length: count }).map((_, i) => (
        <button
          type="button"
          class:list={['dot', { 'is-active': i === 0 }]}
          data-dot
          aria-label={`Přejít na pozici ${i + 1} z ${count}`}
          aria-current={i === 0 ? 'true' : undefined}
        />
      ))
  }
</div>

{/* styl .progress-dots / .dot je globálně ve scroll.css — tečky textové
    dráhy vkládá scroll-engine.ts dynamicky (počet sloupců zná až po layoutu)
    a scoped styl by na ně nedosáhl */}
