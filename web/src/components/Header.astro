---
// Logo + burger. Na desktopu je logo na středu, burger vpravo; na mobilu
// logo vlevo. Burger otevírá menu overlay (BurgerScreen) na všech šířkách.

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
---

<header class="site-header">
  <a class="logo" href="/" data-scroll-to="uvod">{siteName}</a>

  <button
    class="burger"
    data-burger
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="menu"
  >
    <span></span>
    <span></span>
    <span></span>
    <!-- znak * z fontu Karnet (glyf asterisk) — burger se v intervalu
         promění v hvězdičku a zpět -->
    <svg class="burger-star" viewBox="0 0 920 700" aria-hidden="true">
      <path
        d="M284 419Q247 422 181 422H10V277H384V0H536V92Q536 178 533 214Q570 155 606 117L713 0H920L731 198Q701 228 637 280Q675 277 739 277H910V422H536V700H384V608Q384 522 387 486Q350 545 314 583L207 700H0L189 502Q219 472 284 419Z"
      ></path>
    </svg>
  </button>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    /* burger svisle na středu loga (na mobilu dvouřádkového) */
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) calc(var(--page-pad) - 1.5px) 0;
    color: var(--color-chrome);
    mix-blend-mode: difference;
  }

  .logo {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-heavy);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .logo:hover {
    text-decoration: none;
  }

  /* Tloušťka čárky = tah hvězdičky (glyf: 145–152 z 920 jednotek šířky
     → při 32px ≈ 5px). Tři čárky + dvě mezery ≈ výška hvězdičky (24.3px). */
  .burger {
    --burger-line: 5px;
    --burger-gap: 4px;
    /* cyklus začíná rovnou plně vytočenou hvězdičkou (35 % z 8 s) —
       po načtení je první vidět hvězdička, ne čárky */
    --burger-start: -2.8s;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--burger-gap);
    padding: var(--space-xs) 0;
  }

  .burger span {
    display: block;
    width: 30px;
    height: var(--burger-line);
    background: currentColor;
    transition:
      transform var(--duration) var(--ease),
      opacity var(--duration) var(--ease);
    animation: burger-lines 8s var(--ease) var(--burger-start) infinite;
  }

  .burger-star {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 32px;
    max-width: none; /* global.css omezuje svg na šířku rodiče (30px burger) */
    margin: -12.17px 0 0 -16px; /* 32 × 700/920 → výška 24.3px, na střed */
    fill: currentColor;
    opacity: 0;
    pointer-events: none;
    animation: burger-star 8s var(--ease) var(--burger-start) infinite;
  }

  /* Interval (8 s): ~2 s burger → čárky se stáhnou do středu a vytočí
     se hvězdička → ~4.5 s hvězdička → zpět. Čárky i hvězdička běží na
     stejném cyklu, takže se prolnou. */
  @keyframes burger-lines {
    0%,
    26%,
    100% {
      transform: scaleX(1);
    }

    33%,
    92% {
      transform: scaleX(0);
    }
  }

  @keyframes burger-star {
    0%,
    27%,
    100% {
      opacity: 0;
      transform: scale(0.4) rotate(-90deg);
    }

    35%,
    90% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }

    97% {
      opacity: 0;
      transform: scale(0.4) rotate(90deg);
    }
  }

  /* otevřený menu overlay: krajní čárky se složí do křížku (zavření),
     prostřední zmizí; interval stojí a hvězdička je skrytá.
     Posun = výška čárky + mezera (krajní čárka dojede na osu prostřední) */
  :global(html.menu-open) .burger span,
  :global(html.menu-open) .burger-star {
    animation: none;
  }

  :global(html.menu-open) .burger span:first-of-type {
    transform: translateY(calc(var(--burger-line) + var(--burger-gap))) rotate(45deg);
  }

  :global(html.menu-open) .burger span:nth-of-type(2) {
    opacity: 0;
  }

  :global(html.menu-open) .burger span:last-of-type {
    transform: translateY(calc(-1 * (var(--burger-line) + var(--burger-gap)))) rotate(-45deg);
  }

  /* otevřený menu overlay: logo ustupuje pod poloprůhledné menu jako
     zbytek stránky (dle náhledu); zůstává ale klikací — v overlayi Intro
     není, vede na něj právě logo */
  .logo {
    transition: opacity var(--duration) var(--ease);
  }

  :global(html.menu-open) .logo {
    opacity: 0.35;
  }

  /* desktop: logo na středu hlavičky, burger vpravo */
  @media (min-width: 768px) {
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .logo {
      grid-column: 2;
    }

    .burger {
      grid-column: 3;
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger span,
    .logo {
      transition: none;
    }

    .burger span,
    .burger-star {
      animation: none;
    }
  }
</style>
