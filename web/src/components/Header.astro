---
// Logo + burger. Logo je na středu hlavičky (každé slovo na vlastním
// řádku), burger vpravo. Burger otevírá menu overlay (BurgerScreen)
// na všech šířkách.

interface Props {
  siteName: string;
  /** Šipka zpět vlevo (karta projektu → portfolio, page-transition.ts). */
  backHref?: string;
}

const { siteName, backHref } = Astro.props;
// logo láme název po slovech — „Karnet," / „architekti"
const logoLines = siteName.split(/\s+/);
---

<header class="site-header">
  {
    backHref && (
      <a class="back" href={backHref} data-back aria-label="Zpět na portfolio">
        <!-- znak ← z fontu Karnet (glyf arrowleft) -->
        <svg viewBox="0 0 825 700" aria-hidden="true">
          <path d="M349 281Q421 273 505 273H825V426H505Q421 426 348 418Q396 462 444 516L607 700H415L163 413V700H0V0H163V287L415 0H607L444 184Q403 230 349 281Z" />
        </svg>
      </a>
    )
  }

  <a class="logo" href="/" data-scroll-to="uvod">
    {logoLines.map((line) => <span>{line}</span>)}
  </a>

  <button
    class="burger"
    data-burger
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="menu"
  >
    <span></span>
    <span></span>
    <span></span>
    <!-- znak * z fontu Karnet (glyf asterisk) — burger se v intervalu
         promění v hvězdičku a zpět -->
    <svg class="burger-star" viewBox="0 0 920 700" aria-hidden="true">
      <path
        d="M284 419Q247 422 181 422H10V277H384V0H536V92Q536 178 533 214Q570 155 606 117L713 0H920L731 198Q701 228 637 280Q675 277 739 277H910V422H536V700H384V608Q384 522 387 486Q350 545 314 583L207 700H0L189 502Q219 472 284 419Z"
      ></path>
    </svg>
    <!-- znak X z fontu Karnet (glyf X) — zavření otevřeného menu -->
    <svg class="burger-close" viewBox="0 0 814 700" aria-hidden="true">
      <path d="M302 346 7 0H209L407 228L605 0H807L512 346L814 700H611L407 464L203 700H0Z"></path>
    </svg>
  </button>
</header>

<style>
  .site-header {
    /* výška verzálek loga: glyfy Karnet mají cap height 700 z 1000 em —
       hvězdička burgeru a šipka zpět jsou stejně velké jako písmo loga */
    --glyph-h: calc(var(--text-xl) * 0.7);
    /* horní hrana verzálek loga pod vrškem jeho řádku: hhea ascent 1000
       + descent 200 při line-height 1 → baseline 0.9em, verzálka 0.7em */
    --cap-top: calc(var(--text-xl) * 0.2);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: grid;
    /* logo na středu, šipka zpět vlevo, burger vpravo */
    grid-template-columns: 1fr auto 1fr;
    /* burger, hvězdička, X i šipka zpět lícují vrškem s verzálkami
       (prvního řádku) loga */
    align-items: start;
    padding: var(--space-md) calc(var(--page-pad) - 1.5px) 0;
    color: var(--color-chrome);
    mix-blend-mode: difference;
  }

  .logo {
    grid-column: 2;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-heavy);
    letter-spacing: -0.02em;
    line-height: 1;
    text-align: center;
  }

  /* každé slovo názvu na vlastním řádku */
  .logo span {
    display: block;
  }

  .logo:hover {
    text-decoration: none;
  }

  /* šipka zpět — glyf ← z fontu Karnet, stejně velký jako hvězdička
     burgeru (výška verzálek loga); levý sloupec hlavičky, na všech
     šířkách */
  .back {
    position: relative;
    display: flex;
    grid-column: 1;
    justify-self: start;
    margin-top: var(--cap-top);
  }

  .back::after {
    content: '';
    position: absolute;
    inset: -10px;
  }

  .back svg {
    width: calc(var(--glyph-h) * 825 / 700);
    height: var(--glyph-h);
    max-width: none;
    fill: currentColor;
    transition: transform var(--duration) var(--ease);
  }

  .back:hover svg {
    transform: translateX(-3px);
  }

  /* Tloušťka čárky ≈ tah hvězdičky (glyf: 145–152 z 700 jednotek výšky
     → ≈ 5px). Tři čárky + dvě mezery ≈ výška hvězdičky. */
  .burger {
    --burger-line: 5px;
    --burger-gap: 4px;
    /* cyklus začíná rovnou plně vytočenou hvězdičkou (35 % z 8 s) —
       po načtení je první vidět hvězdička, ne čárky */
    --burger-start: -2.8s;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--burger-gap);
    grid-column: 3;
    justify-self: end;
    padding: var(--space-xs) 0;
    /* vršek čárek (obsah pod paddingem) = vršek verzálek loga */
    margin-top: calc(var(--cap-top) - var(--space-xs));
  }

  .burger span {
    display: block;
    width: 30px;
    height: var(--burger-line);
    background: currentColor;
    transition:
      transform var(--duration) var(--ease),
      opacity var(--duration) var(--ease);
    animation: burger-lines 8s var(--ease) var(--burger-start) infinite;
  }

  /* hvězdička je velká jako písmo loga (výška glyfu = verzálka loga),
     pravým okrajem lícuje s čárkami, vrškem s horní čárkou */
  .burger-star {
    position: absolute;
    top: var(--space-xs);
    right: 0;
    width: calc(var(--glyph-h) * 920 / 700);
    height: var(--glyph-h);
    max-width: none; /* global.css omezuje svg na šířku rodiče (30px burger) */
    fill: currentColor;
    opacity: 0;
    pointer-events: none;
    animation: burger-star 8s var(--ease) var(--burger-start) infinite;
  }

  /* Interval (8 s): ~2 s burger → čárky se stáhnou do středu a vytočí
     se hvězdička → ~4.5 s hvězdička → zpět. Čárky i hvězdička běží na
     stejném cyklu, takže se prolnou. */
  @keyframes burger-lines {
    0%,
    26%,
    100% {
      transform: scaleX(1);
    }

    33%,
    92% {
      transform: scaleX(0);
    }
  }

  @keyframes burger-star {
    0%,
    27%,
    100% {
      opacity: 0;
      transform: scale(0.4) rotate(-90deg);
    }

    35%,
    90% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }

    97% {
      opacity: 0;
      transform: scale(0.4) rotate(90deg);
    }
  }

  /* zavírací X — glyf z fontu Karnet ve výšce verzálek loga, umístěný
     jako hvězdička (pravým okrajem lícuje s čárkami, vrškem s horní) */
  .burger-close {
    position: absolute;
    top: var(--space-xs);
    right: 0;
    width: calc(var(--glyph-h) * 814 / 700);
    height: var(--glyph-h);
    max-width: none; /* global.css omezuje svg na šířku rodiče (30px burger) */
    fill: currentColor;
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
    transition:
      opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  /* otevřený menu overlay: čárky se stáhnou, interval stojí, hvězdička
     je skrytá a místo nich je X (zavření) */
  :global(html.menu-open) .burger span,
  :global(html.menu-open) .burger-star {
    animation: none;
  }

  :global(html.menu-open) .burger span {
    transform: scaleX(0);
  }

  :global(html.menu-open) .burger-close {
    opacity: 1;
    transform: none;
  }

  /* otevřený menu overlay: logo ustupuje pod poloprůhledné menu jako
     zbytek stránky (dle náhledu); zůstává ale klikací — v overlayi Intro
     není, vede na něj právě logo */
  .logo {
    transition: opacity var(--duration) var(--ease);
  }

  :global(html.menu-open) .logo {
    opacity: 0.35;
  }

  /* nad tmavým podkladem menu by difference dal šedou na šedé
     (chrome − overlay) — hlavička je při otevřeném menu tmavá bez blendu */
  :global(html.menu-open) .site-header {
    color: var(--color-text);
    mix-blend-mode: normal;
  }

  @media (prefers-reduced-motion: reduce) {
    .burger span,
    .burger-close,
    .logo {
      transition: none;
    }

    .burger span,
    .burger-star {
      animation: none;
    }
  }
</style>
