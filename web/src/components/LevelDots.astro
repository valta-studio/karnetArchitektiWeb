---
// Svislý tečkovaný indikátor vertikálních úrovní u pravého okraje
// (dle náhledů). Aktivní tečku přepíná scroll-engine.ts.
interface Props {
  count: number;
}

const { count } = Astro.props;
---

{
  count > 1 && (
    <div class="level-dots" aria-hidden="true">
      {Array.from({ length: count }).map((_, i) => (
        <span class:list={['level-dot', { 'is-active': i === 0 }]} data-level-dot />
      ))}
    </div>
  )
}

<style>
  .level-dots {
    position: fixed;
    right: var(--page-pad);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 5;
  }

  .level-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-line);
    transition: background var(--duration) var(--ease);
  }

  .level-dot.is-active {
    background: var(--color-text);
  }
</style>
