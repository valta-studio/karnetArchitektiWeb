---
// Svislý indikátor vertikálních úrovní u pravého okraje:
// neaktivní pozice jsou tečky, aktivní pointer je čárka.
interface Props {
  count: number;
}

const { count } = Astro.props;
---

{
  count > 1 && (
    <div class="level-dots" role="navigation" aria-label="Posun mezi sekcemi">
      {Array.from({ length: count }).map((_, i) => (
        <button
          type="button"
          class:list={['level-dot', { 'is-active': i === 0 }]}
          data-level-dot
          aria-label={`Přejít na sekci ${i + 1} z ${count}`}
          aria-current={i === 0 ? 'true' : undefined}
        />
      ))}
    </div>
  )
}

<style>
  .level-dots {
    position: fixed;
    right: var(--page-pad);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    z-index: 5;
    color: var(--color-chrome);
    mix-blend-mode: difference;
  }

  .level-dot {
    width: 16px;
    height: 4px;
    position: relative;
    flex: none;
    background: currentColor;
    opacity: 0.45;
    transition:
      width var(--duration) var(--ease),
      height var(--duration) var(--ease),
      border-radius var(--duration) var(--ease),
      opacity var(--duration) var(--ease);
  }

  .level-dot.is-active {
    width: 16px;
    height: 4px;
    border-radius: 0;
    opacity: 1;
  }

  .level-dot::after {
    content: '';
    position: absolute;
    inset: -5px;
  }
</style>
