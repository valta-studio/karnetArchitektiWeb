---
// Svislý indikátor (obdélníky) vertikálních úrovní u pravého okraje
// (dle náhledů). Aktivní tečku přepíná scroll-engine.ts.
interface Props {
  count: number;
}

const { count } = Astro.props;
---

{
  count > 1 && (
    <div class="level-dots" role="navigation" aria-label="Posun mezi sekcemi">
      {Array.from({ length: count }).map((_, i) => (
        <button
          type="button"
          class:list={['level-dot', { 'is-active': i === 0 }]}
          data-level-dot
          aria-label={`Přejít na sekci ${i + 1} z ${count}`}
          aria-current={i === 0 ? 'true' : undefined}
        />
      ))}
    </div>
  )
}

<style>
  .level-dots {
    position: fixed;
    right: var(--page-pad);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    z-index: 5;
    color: var(--color-chrome);
    mix-blend-mode: difference;
  }

  /* svislá osa → svislé obdélníky, aktivní se prodlouží a zesílí;
     neaktivní jsou tlumené průhledností (sedí i přes blend difference) */
  .level-dot {
    width: 4px;
    height: 12px;
    position: relative;
    flex: none;
    background: currentColor;
    opacity: 0.35;
    transition:
      height var(--duration) var(--ease),
      opacity var(--duration) var(--ease);
  }

  /* krajní tečka okna (max 5, syncDots), za kterou pokračují skryté —
     0.4 × běžná neaktivní */
  .level-dot.is-edge {
    opacity: calc(0.35 * 0.4);
  }

  .level-dot.is-active {
    height: 24px;
    opacity: 1;
  }

  .level-dot::after {
    content: '';
    position: absolute;
    inset: -5px;
  }
</style>
