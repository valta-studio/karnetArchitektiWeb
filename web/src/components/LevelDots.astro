---
// Svislý tečkovaný indikátor vertikálních úrovní u pravého okraje
// (dle náhledů). Aktivní tečku přepíná scroll-engine.ts.
interface Props {
  count: number;
}

const { count } = Astro.props;
---

{
  count > 1 && (
    <div class="level-dots" role="navigation" aria-label="Posun mezi sekcemi">
      {Array.from({ length: count }).map((_, i) => (
        <button
          type="button"
          class:list={['level-dot', { 'is-active': i === 0 }]}
          data-level-dot
          aria-label={`Přejít na sekci ${i + 1} z ${count}`}
          aria-current={i === 0 ? 'true' : undefined}
        />
      ))}
    </div>
  )
}

<style>
  .level-dots {
    position: fixed;
    right: var(--page-pad);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    z-index: 5;
    color: var(--color-chrome);
    mix-blend-mode: difference;
  }

  .level-dot {
    width: 8px;
    height: 8px;
    position: relative;
    flex: none;
    border-radius: 50%;
    background: currentColor;
    transition:
      width var(--duration) var(--ease),
      height var(--duration) var(--ease);
  }

  .level-dot.is-active {
    width: 12px;
    height: 12px;
  }

  .level-dot::after {
    content: '';
    position: absolute;
    inset: -5px;
  }

  /* mobil: menu obrazovka (vždy poslední úroveň) není ve scroll toku —
     otevírá se jako overlay burgerem, její tečka se skrývá */
  @media (max-width: 767px) {
    .level-dot:last-child {
      display: none;
    }
  }
</style>
