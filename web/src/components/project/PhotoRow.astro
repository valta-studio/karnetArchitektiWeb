---
// Karta projektu — úroveň 1 (dle náhledů): fotky v přirozených proporcích,
// výška ~72dvh, centrované, další fotka „nakukuje" od kraje.
import ProgressDots from '../ProgressDots.astro';
import SanityImage from '../SanityImage.astro';
import ScrollRow from '../ScrollRow.astro';
import { isMockImage } from '../../lib/image';
import type { ImageSource, Project } from '../../types/sanity';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Náhledová fotka z portfolia je na kartě vždy první (přechod z portfolia
// na ni plynule navazuje); pokud je zároveň mezi fotkami, podruhé se nezobrazí.
const assetKey = (image: ImageSource) =>
  isMockImage(image) ? image.src : image.asset._ref;
const coverKey = project.cover ? assetKey(project.cover) : undefined;
const photos = [
  ...(project.cover ? [project.cover] : []),
  ...(project.photos ?? []).filter((photo) => assetKey(photo) !== coverKey),
];
---

<section class="level photo-row" data-level="fotky" id="fotky">
  <ScrollRow id="photo-row" loop>
    {
      photos.map((photo, index) => (
        <div class="photo-panel" data-cover={index === 0 || undefined}>
          <SanityImage
            image={photo}
            alt={`${project.title} — fotografie ${index + 1}`}
            sizes="(min-width: 768px) 60vw, 90vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            class="photo-img"
            skeleton
          />
        </div>
      ))
    }
  </ScrollRow>

  {/* název nad tečkami (fixed) — cíl přechodu z názvu v portfoliu
       (page-transition.ts); h1 je až v textové úrovni */}
  <p class="photo-row-title">{project.title}</p>

  <ProgressDots rowId="photo-row" count={photos.length} />
</section>

<style>
  .photo-row :global(.scroll-row) {
    min-height: 100svh;
    align-items: center;
    /* stejná mezera jako mezi textovými panely (TextRow) */
    gap: var(--page-pad);
    padding-inline: 35vw;
  }

  .photo-panel {
    scroll-snap-align: center;
    height: 72dvh;
    display: flex;
    align-items: center;
    transition: opacity 300ms var(--ease);
  }

  /* jako portfolio: vzdálenost od aktivní fotky (data-row-distance,
     scroll-engine) — okolní fotky blednou */
  .photo-panel[data-row-distance='1'] {
    opacity: 0.4;
  }

  .photo-panel[data-row-distance='2'] {
    opacity: 0.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-panel {
      transition: none;
    }
  }

  /* cíl přechodu z portfolia (page-transition.ts) — jen originál, klony
     smyčky jméno nést nesmí (duplicitní jméno přechod zruší) */
  .photo-panel[data-cover]:not([data-loop-clone]) :global(.photo-img) {
    view-transition-name: project-cover;
  }

  /* stejný styl jako název pod fotkou v portfoliu; sedí nad tečkami
     (scroll.css .progress-dots: bottom --space-lg, výška 4px). Fixed —
     zůstává vidět na všech úrovních karty; z-index jako svislé tečky
     (LevelDots), pod burger obrazovkou (9) */
  .photo-row-title {
    position: fixed;
    z-index: 5;
    left: 50%;
    bottom: calc(var(--space-lg) + 4px + var(--space-sm));
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 2 * var(--page-pad));
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: 1.2;
    text-align: center;
    view-transition-name: project-title;
  }

  .photo-row :global(.photo-img) {
    height: 100%;
    width: auto;
    max-width: none;
  }

  @media (max-width: 767px) {
    .photo-row :global(.scroll-row) {
      padding-inline: 9vw;
    }

    .photo-panel {
      height: 62dvh;
    }

    /* tečky jsou na mobilu níž (scroll.css: bottom --space-sm) */
    .photo-row-title {
      bottom: calc(var(--space-sm) + 4px + var(--space-sm));
    }

    .photo-row :global(.photo-img) {
      max-width: 82vw;
      object-fit: contain;
    }
  }
</style>
