---
// Karta projektu — úroveň 2: název + metadata + perex v prvním panelu,
// každý textový odstavec ve vlastním panelu (jako ateliér) — obsah panelu
// je svisle na středu. Odstavec delší, než se vejde na výšku, rozdělí
// scroll-engine (paginateText) do více panelů podobné výšky.
import ProgressDots from '../ProgressDots.astro';
import ScrollRow from '../ScrollRow.astro';
import type { Project } from '../../types/sanity';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const columns = project.columns ?? [];
---

<section class="level text-row" data-level="text" id="text">
  <ScrollRow id="text-row" class="text-scroll" loop>
    <div class="text-panel row-fade">
      <div class="text-lead">
        <h1 class="project-title">{project.title}</h1>

        <p class="project-meta">
          {project.years && <span>Rok: {project.years}<br /></span>}
          {project.location && <span>Lokalita: {project.location}<br /></span>}
          {
            project.credits?.map((credit) => (
              <span>
                {credit.role}: {credit.name}
                <br />
              </span>
            ))
          }
        </p>

        {project.perex && <p class="project-perex pre-line">{project.perex}</p>}
      </div>
    </div>

    {
      columns.map((column) => (
        <div class="text-panel row-fade">
          <p class="text-column pre-line" data-paginate>
            {column}
          </p>
        </div>
      ))
    }
  </ScrollRow>

  <ProgressDots rowId="text-row" count={columns.length + 1} />
</section>

<style>
  /* jako ateliér: aktivní panel na středu obrazovky (center-snap) */
  .text-row :global(.text-scroll) {
    min-height: 100svh;
    align-items: center;
    column-gap: var(--page-pad);
  }

  /* konec: skutečný flex spacer (koncový padding overflow flexboxu
     Safari nespolehlivě započítá) */
  .text-row :global(.text-scroll)::after {
    content: '';
    flex: 0 0 50vw;
  }

  /* panel = sloupec textu, obsah svisle na středu (jako ateliér) */
  .text-panel {
    display: flex;
    align-items: center;
    width: var(--text-column-width);
    scroll-snap-align: center;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
    transition: opacity 300ms var(--ease);
  }

  /* jako portfolio: vzdálenost od aktivního panelu (data-row-distance,
     scroll-engine) — okolní panely blednou */
  .text-panel[data-row-distance='1'] {
    opacity: 0.4;
  }

  .text-panel[data-row-distance='2'] {
    opacity: 0.3;
  }

  /* strop výšky textu v panelu — delší odstavce stránkuje scroll-engine
     (svh: výška nesmí skákat se schováním address baru) */
  .text-lead,
  .text-column {
    max-height: 66svh;
  }

  .project-title {
    font-size: var(--text-lg);
    margin-bottom: 0.8em;
  }

  .project-meta {
    margin-bottom: 1.2em;
  }

  .project-perex,
  .pre-line {
    white-space: pre-line;
  }

  @media (max-width: 767px) {
    .text-lead,
    .text-column {
      max-height: 72svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-panel {
      transition: none;
    }
  }
</style>
