---
// Úroveň 2 — ateliér (dle náhledů): texty ve dvou sloupcích přes zesvětlené
// úvodní médium, ocenění jako prozaické odstavce, závěrem založení + lidé.
// Panely jsou užší než viewport — další „nakukuje". Fotky jsou samostatné
// panely mezi texty — každá textová sekce má před/za sebou vlastní seznam
// (`photosStart`, `photosAfterIntro`, `photosAfterAwards`, `photosEnd`).
import ProgressDots from '../ProgressDots.astro';
import SanityImage from '../SanityImage.astro';
import ScrollRow from '../ScrollRow.astro';
import { portableTextToHtml } from '../../lib/portable-text';
import {
  INTRO_MEDIA_MAX_WIDTH,
  INTRO_MEDIA_SIZES,
  introPosterUrl,
  introVideoSrc,
} from '../../lib/image';
import type { AtelierLevel, AtelierPhoto, IntroLevel } from '../../types/sanity';

interface Props {
  data: AtelierLevel;
  /** Úvodní médium — v náhledu prosvítá za texty (video, nebo foto). */
  intro?: IntroLevel;
}

const { data, intro } = Astro.props;

const backdropIsVideo = Boolean(introVideoSrc(intro));
const backdropImage = intro?.photo ?? intro?.poster;
const backdropPosterUrl = introPosterUrl(intro);

const introHtml = portableTextToHtml(data.intro);
const hasAwards = Boolean(data.awardsIntro || data.awards?.length);

const hasPeople = Boolean(data.founding || data.people?.length);

// Na mobilu se založení a lidé dělí do dvou panelů (jen když jsou obojí).
const splitPeople = Boolean(data.founding && data.people?.length);

// Pořadí panelů: texty v pevném pořadí, mezi nimi seznamy fotek (nula,
// jedna nebo více) v pořadí ze Studia.
const slots = {
  start: data.photosStart ?? [],
  afterIntro: data.photosAfterIntro ?? [],
  afterAwards: data.photosAfterAwards ?? [],
  end: data.photosEnd ?? [],
};

// Zpětná kompatibilita: dokud obsah neprošel migrací
// `atelier-photos-by-section`, fotky sedí ve starém poli `photos` s volbou
// umístění u každé z nich. Použije se jen když jsou nové seznamy prázdné.
if (!Object.values(slots).some((list) => list.length) && data.photos?.length) {
  for (const photo of data.photos) {
    slots[photo.placement ?? 'afterIntro'].push(photo);
  }
}

let photoIndex = 0;
const photoSegments = (list: AtelierPhoto[]) =>
  list.map((photo) => ({ kind: 'photo' as const, photo, index: photoIndex++ }));

type Segment = { kind: 'intro' | 'awards' | 'people' } | ReturnType<typeof photoSegments>[number];

const segments: Segment[] = [
  ...photoSegments(slots.start),
  ...(introHtml ? [{ kind: 'intro' as const }] : []),
  ...photoSegments(slots.afterIntro),
  ...(hasAwards ? [{ kind: 'awards' as const }] : []),
  ...photoSegments(slots.afterAwards),
  ...(hasPeople ? [{ kind: 'people' as const }] : []),
  ...photoSegments(slots.end),
];

// výchozí počet teček (desktop); na mobilu je scroll-engine přepočítá
const panelCount = segments.length;
---

<section class="level atelier" data-level="atelier" id="atelier">
  {
    (backdropIsVideo || backdropImage) && (
      <div class="atelier-backdrop" aria-hidden="true">
        {backdropIsVideo ? (
          /* Ne druhý <video> se stejným URL — to je dvojí stažení i dvojí
             dekodér. Zrcadlíme snímky elementu z úrovně 1 do canvasu
             (viz scripts/video.ts); do prvního snímku drží poster. */
          <canvas
            data-intro-mirror
            style={backdropPosterUrl ? `background-image: url("${backdropPosterUrl}")` : undefined}
          />
        ) : (
          <SanityImage
            image={backdropImage!}
            alt=""
            sizes={INTRO_MEDIA_SIZES}
            maxWidth={INTRO_MEDIA_MAX_WIDTH}
          />
        )}
      </div>
    )
  }

  <ScrollRow id="atelier-row" loop>
    {
      segments.map((segment) =>
        segment.kind === 'photo' ? (
          <div class="atelier-panel atelier-photo-panel row-fade">
            <SanityImage
              image={segment.photo}
              alt={segment.photo.alt ?? `Ateliér — fotografie ${segment.index + 1}`}
              sizes="(min-width: 768px) 60vw, 90vw"
              class="atelier-photo"
              skeleton
            />
          </div>
        ) : segment.kind === 'intro' ? (
          <div class="atelier-panel atelier-text-panel row-fade">
            <div class="atelier-intro" set:html={introHtml} />
          </div>
        ) : segment.kind === 'awards' ? (
          <div class="atelier-panel atelier-text-panel row-fade">
            <div class="awards">
              {data.awardsIntro && <p>{data.awardsIntro}</p>}
              {data.awards?.map((award) => (
                <p>{award.text}</p>
              ))}
            </div>
          </div>
        ) : (
          <>
            <div class:list={['atelier-panel atelier-text-panel row-fade', { 'atelier-desktop-only': splitPeople }]}>
              <div class="atelier-people">
                {data.founding && <p>{data.founding}</p>}
                {data.people?.length ? (
                  <ul>
                    {data.people.map((person) => (
                      <li>
                        {person.degree && <span class="degree">{person.degree} </span>}
                        {person.name}
                      </li>
                    ))}
                  </ul>
                ) : null}
              </div>
            </div>

            {/* mobil: založení a lidé jako dva samostatné panely (na desktopu
                skryté — scroll-engine počítá tečky jen z vykreslených panelů) */}
            {splitPeople && (
              <>
                <div class="atelier-panel atelier-text-panel row-fade atelier-mobile-only">
                  <div class="atelier-people">
                    <p>{data.founding}</p>
                  </div>
                </div>
                <div class="atelier-panel atelier-text-panel row-fade atelier-mobile-only">
                  <div class="atelier-people">
                    <ul>
                      {data.people!.map((person) => (
                        <li>
                          {person.degree && <span class="degree">{person.degree} </span>}
                          {person.name}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </>
            )}
          </>
        )
      )
    }
  </ScrollRow>

  <ProgressDots rowId="atelier-row" count={panelCount} />
</section>

<style>
  .atelier {
    /* Podkres se při vstupu přesune nad předchozí úroveň; nesmí ho
       oříznout výchozí overflow na .level. */
    overflow: visible;
  }

  .atelier-backdrop {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* na středu pod hlavičkou, stejně jako médium v úvodu */
    padding-top: var(--header-bottom);
    pointer-events: none;
    opacity: 0.14;
    z-index: 1;
    will-change: opacity;
    backface-visibility: hidden;
  }

  .atelier-backdrop :global(img),
  .atelier-backdrop :global(canvas) {
    width: min(34vw, 560px);
    /* Musí mít stejnou stabilní geometrii jako médium v úvodu. */
    height: 72svh;
    object-fit: cover;
  }

  /* Podkres drží jen na výchozím panelu; po přejetí vlevo/vpravo zmizí
     (data-row-at-start, scroll-engine). Opacity na dítěti — opacity
     samotného podkresu řídí scroll-driven animace. Na úvodu je podkres
     samotné úvodní médium (originál pod ním zmizel, IntroLevel) — tam se
     vrací bez ohledu na polohu dráhy (data-active-level, scroll-engine). */
  .atelier-backdrop > :global(*) {
    transition: opacity 400ms var(--ease);
  }

  :global(
      html:not([data-active-level='uvod'])
        .atelier:has(.scroll-row:not([data-row-at-start]))
        .atelier-backdrop
        > *
    ) {
    opacity: 0;
  }

  /* Poster pod zrcadlem — canvas je do prvního snímku průhledný. */
  .atelier-backdrop :global(canvas) {
    background-position: center;
    background-size: cover;
  }

  /* Přechod z úvodu: podkres je skutečně fixovaný ve stabilním svh
     viewportu. Scroll-driven animace mění pouze opacity — opačná transformace
     proti scrollu v Safari mezi snímky vertikálně kmitala. První čtvrtinu
     vstupu je médium plně viditelné, v Ateliéru zůstane na 14 % a při
     odjezdu do Portfolia zmizí. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .atelier {
        view-timeline: --atelier block;
      }

      .atelier-backdrop {
        position: fixed;
        inset: 0 auto auto 0;
        width: 100vw;
        height: 100svh;
        animation: backdrop-settle linear both;
        animation-timeline: --atelier;
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes backdrop-settle {
    0%,
    12.5% {
      opacity: 1;
    }

    50%,
    75% {
      opacity: 0.14;
    }

    to {
      opacity: 0;
    }
  }

  /* Podkres drží geometrii úvodního média — na mobilu je úzkých 34vw
     (viz IntroLevel), médium se musí protáhnout stejně. */
  @media (max-width: 767px) {
    .atelier-backdrop :global(img),
    .atelier-backdrop :global(canvas) {
      width: 82vw;
      height: 66svh;
    }
  }

  .atelier :global(.scroll-row) {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    align-items: center;
    /* panely na středu prostoru pod hlavičkou — stejná osa jako podkres
       (a médium v úvodu), jinak fotka sedí o půl hlavičky výš */
    padding-top: var(--header-bottom);
    /* stejná mezera jako na ostatních drahách */
    gap: var(--page-pad);
  }

  /* Konec: skutečný flex spacer místo padding-right — koncový padding
     overflow flexboxu Safari nespolehlivě započítá. */
  .atelier :global(.scroll-row)::after {
    content: '';
    flex: 0 0 50vw;
  }

  .atelier-panel {
    scroll-snap-align: center;
    flex: none;
    /* plynulé tlumení (.row-fade): sousední panely jako vzdálenější */
    --fade-near: 0.3;
    transition:
      opacity 300ms var(--ease),
      color 300ms var(--ease);
  }

  /* Jako portfolio: vzdálenost od aktivního panelu (data-row-distance,
     scroll-engine) — sousední panely mají šedý text a lehce blednou,
     vzdálenější blednou výrazně. */
  .atelier-panel[data-row-distance='1'] {
    opacity: 0.3;
    color: var(--color-muted);
  }

  .atelier-panel[data-row-distance='2'] {
    opacity: 0.3;
  }

  /* šedý text sousedů plynule podle polohy, jako tlumení (.row-fade);
     druhá animace vedle row-fade — sdílí její časovou osu i rozsah */
  @supports (animation-timeline: view()) {
    .atelier-panel {
      animation-name: row-fade, atelier-tint;
    }
  }

  @keyframes atelier-tint {
    0%,
    50%,
    100% {
      color: var(--color-text);
    }

    25%,
    75% {
      color: var(--color-muted);
    }
  }

  /* Textový i fotkový panel mají stejnou výšku a jsou svisle na středu;
     text je v panelu nahoře — všechny texty začínají na společné lince
     s horní hranou fotek. */
  .atelier-text-panel,
  .atelier-photo-panel {
    height: 72dvh;
    display: flex;
  }

  .atelier-text-panel {
    /* Stejná geometrie jako textové sloupce projektu: šířka textu +
       page-pad mezera tvoří jeden vodorovný krok. */
    align-items: flex-start;
    justify-content: flex-start;
    width: var(--text-column-width);
  }

  /* Fotka: jeden panel = jedna zastávka, přirozené proporce jako fotky
     na kartě projektu (PhotoRow). */
  .atelier-photo-panel {
    align-items: center;
  }

  .atelier :global(.atelier-photo) {
    height: 100%;
    width: auto;
    max-width: none;
  }

  @media (max-width: 767px) {
    .atelier-text-panel,
    .atelier-photo-panel {
      height: 62dvh;
    }

    .atelier :global(.atelier-photo) {
      max-width: 82vw;
      object-fit: contain;
      /* contain fotku v rámečku centruje — viditelná fotka musí začínat
         na společné horní lince s texty */
      object-position: top;
    }
  }

  /* varianty panelu založení + lidé: desktop jeden, mobil dva */
  .atelier-panel.atelier-mobile-only {
    display: none;
  }

  @media (max-width: 767px) {
    .atelier-panel.atelier-desktop-only {
      display: none;
    }

    .atelier-panel.atelier-mobile-only {
      display: flex;
    }
  }

  .atelier-intro,
  .awards,
  .atelier-people {
    width: var(--text-column-width);
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }

  /* Úvodní texty studia jsou sazené těsněji než ostatní odstavce. */
  .atelier-intro {
    line-height: var(--leading-tight);
  }

  /* Prosté textové pole ze Studia — Enter (\n) je zalomení řádku. */
  .awards p,
  .atelier-people p {
    white-space: pre-line;
  }

  .atelier-intro :global(p + p),
  .awards p + p,
  .atelier-people p + ul {
    margin-top: 1.2em;
  }

  .degree {
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .atelier-backdrop :global(img) {
      width: 82vw;
      height: 66svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atelier-panel,
    .atelier-backdrop > :global(*) {
      transition: none;
    }
  }
</style>
