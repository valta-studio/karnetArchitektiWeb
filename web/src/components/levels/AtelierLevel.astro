---
// Úroveň 2 — ateliér (dle náhledů): texty ve dvou sloupcích přes zesvětlené
// úvodní médium, ocenění jako prozaické odstavce, koláž publikací,
// závěrem založení + lidé. Panely jsou užší než viewport — další „nakukuje".
import ProgressDots from '../ProgressDots.astro';
import SanityImage from '../SanityImage.astro';
import ScrollRow from '../ScrollRow.astro';
import { portableTextToHtml } from '../../lib/portable-text';
import { INTRO_MEDIA_MAX_WIDTH, INTRO_MEDIA_SIZES, isMockImage, urlFor } from '../../lib/image';
import type { AtelierLevel, IntroLevel } from '../../types/sanity';

interface Props {
  data: AtelierLevel;
  /** Úvodní médium — v náhledu prosvítá za texty (video, nebo foto). */
  intro?: IntroLevel;
}

const { data, intro } = Astro.props;

const backdropVideoSrc = intro?.videoFileUrl ?? intro?.videoUrl;
const backdropIsVideo = intro?.mode === 'video' && Boolean(backdropVideoSrc);
const backdropImage = intro?.photo ?? intro?.poster;

const backdropPosterUrl = intro?.poster
  ? isMockImage(intro.poster)
    ? intro.poster.src
    : urlFor(intro.poster).width(1200).url()
  : undefined;

const introHtml = portableTextToHtml(data.intro);
const publications = data.publications ?? [];
const publicationPages = Array.from(
  { length: Math.ceil(publications.length / 2) },
  (_, index) => publications.slice(index * 2, index * 2 + 2)
);
const hasAwards = Boolean(data.awardsIntro || data.awards?.length);

const panelCount =
  (introHtml ? 1 : 0) +
  (hasAwards ? 1 : 0) +
  publicationPages.length +
  (data.founding || data.people?.length ? 1 : 0);
---

<section class="level atelier" data-level="atelier" id="atelier">
  {
    (backdropIsVideo || backdropImage) && (
      <div class="atelier-backdrop" aria-hidden="true">
        {backdropIsVideo ? (
          /* Ne druhý <video> se stejným URL — to je dvojí stažení i dvojí
             dekodér. Zrcadlíme snímky elementu z úrovně 1 do canvasu
             (viz scripts/video.ts); do prvního snímku drží poster. */
          <canvas
            data-intro-mirror
            style={backdropPosterUrl ? `background-image: url("${backdropPosterUrl}")` : undefined}
          />
        ) : (
          <SanityImage
            image={backdropImage!}
            alt=""
            sizes={INTRO_MEDIA_SIZES}
            maxWidth={INTRO_MEDIA_MAX_WIDTH}
          />
        )}
      </div>
    )
  }

  <ScrollRow id="atelier-row">
    {
      introHtml && (
        <div class="atelier-panel atelier-text-panel">
          <div class="atelier-intro" set:html={introHtml} />
        </div>
      )
    }

    {
      hasAwards && (
        <div class="atelier-panel atelier-text-panel">
          <div class="awards">
            {data.awardsIntro && <p>{data.awardsIntro}</p>}
            {data.awards?.map((award) => (
              <p>{award.text}</p>
            ))}
          </div>
        </div>
      )
    }

    {
      publicationPages.map((page) => (
        <div class="atelier-panel atelier-publications">
          {page.map((publication) => (
            <div class="atelier-publication">
              <SanityImage
                image={publication}
                alt={publication.caption ?? 'Publikace'}
                sizes="(min-width: 768px) 28vw, 80vw"
                maxWidth={1080}
              />
            </div>
          ))}
        </div>
      ))
    }

    {
      data.founding || data.people?.length ? (
        <div class="atelier-panel atelier-text-panel">
          <div class="atelier-people">
            {data.founding && <p>{data.founding}</p>}
            {data.people?.length ? (
              <ul>
                {data.people.map((person) => (
                  <li>
                    {person.degree && <span class="degree">{person.degree} </span>}
                    {person.name}
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
        </div>
      ) : null
    }
  </ScrollRow>

  <ProgressDots rowId="atelier-row" count={panelCount} />
</section>

<style>
  .atelier {
    /* Podkres se při vstupu přesune nad předchozí úroveň; nesmí ho
       oříznout výchozí overflow na .level. */
    overflow: visible;
  }

  .atelier-backdrop {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0.14;
    z-index: 1;
    will-change: opacity;
    backface-visibility: hidden;
  }

  .atelier-backdrop :global(img),
  .atelier-backdrop :global(canvas) {
    width: min(34vw, 560px);
    /* Musí mít stejnou stabilní geometrii jako médium v úvodu. */
    height: 72svh;
    object-fit: cover;
  }

  /* Poster pod zrcadlem — canvas je do prvního snímku průhledný. */
  .atelier-backdrop :global(canvas) {
    background-position: center;
    background-size: cover;
  }

  /* Přechod z úvodu: podkres je skutečně fixovaný ve stabilním svh
     viewportu. Scroll-driven animace mění pouze opacity — opačná transformace
     proti scrollu v Safari mezi snímky vertikálně kmitala. První čtvrtinu
     vstupu je médium plně viditelné, v Ateliéru zůstane na 14 % a při
     odjezdu do Portfolia zmizí. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .atelier {
        view-timeline: --atelier block;
      }

      .atelier-backdrop {
        position: fixed;
        inset: 0 auto auto 0;
        width: 100vw;
        height: 100svh;
        animation: backdrop-settle linear both;
        animation-timeline: --atelier;
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes backdrop-settle {
    0%,
    12.5% {
      opacity: 1;
    }

    50%,
    75% {
      opacity: 0.14;
    }

    to {
      opacity: 0;
    }
  }

  /* Podkres drží geometrii úvodního média — na mobilu je úzkých 34vw
     (viz IntroLevel), médium se musí protáhnout stejně. */
  @media (max-width: 767px) {
    .atelier-backdrop :global(img),
    .atelier-backdrop :global(canvas) {
      width: 82vw;
      height: 66svh;
    }
  }

  .atelier :global(.scroll-row) {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    align-items: center;
    gap: var(--page-pad);
    padding-inline: var(--page-pad);
    scroll-padding-inline-start: var(--page-pad);
  }

  /* Desktop jako portfolio: obsah začíná na 35vw (prázdno vlevo) a aktivní
     panel se na tuto osu i vrací — levý padding drží prostor, scroll-padding
     dělá ze scrollLeft 0 první snap bod. */
  @media (min-width: 768px) {
    .atelier :global(.scroll-row) {
      padding-inline: 35vw;
      scroll-padding-inline-start: 35vw;
    }
  }

  /* Skutečný flex spacer dovolí poslednímu panelu dosnapovat pod logo.
     Funguje spolehlivěji než koncový padding overflow flexboxu v Safari. */
  .atelier :global(.scroll-row)::after {
    content: '';
    flex: 0 0 calc(100vw - var(--text-step) - var(--page-pad));
  }

  .atelier-panel {
    scroll-snap-align: start;
    flex: none;
  }

  .atelier-text-panel {
    /* Stejná geometrie jako textové sloupce projektu: šířka textu +
       page-pad mezera tvoří jeden vodorovný krok. */
    display: flex;
    justify-content: flex-start;
    width: var(--content-text-width);
  }

  .atelier-intro,
  .awards,
  .atelier-people {
    width: var(--content-text-width);
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }

  /* Úvodní texty studia jsou sazené těsněji než ostatní odstavce. */
  .atelier-intro {
    line-height: var(--leading-tight);
  }

  .atelier-intro :global(p + p),
  .awards p + p,
  .atelier-people p + ul {
    margin-top: 1.2em;
  }

  /* Publikace jsou rozdělené do samostatných snap panelů po dvou
     fotografiích. Každý vodorovný krok tak ukáže další dvojici. */
  .atelier-publications {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(2, auto);
    align-content: center;
    justify-content: start;
    column-gap: clamp(0.75rem, 1.75vw, 2rem);
    row-gap: clamp(0.75rem, 2vw, 2rem);
  }

  .atelier-publication {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .atelier-publication :global(img) {
    width: auto;
    max-width: min(34vw, 620px);
    max-height: 34dvh;
  }

  .degree {
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .atelier-backdrop :global(img) {
      width: 82vw;
      height: 66svh;
    }

    .atelier-publication :global(img) {
      max-width: 78vw;
      max-height: 38dvh;
    }
  }
</style>
