---
// Úroveň 3 — portfolio (dle náhledů): volně rozmístěné fotky projektů
// v přirozených proporcích, název pod fotkou, horizontální posun.
// Desktop: dvě řady se střídavými offsety, mobil: jeden projekt na obrazovku.
import ProgressDots from '../ProgressDots.astro';
import SanityImage from '../SanityImage.astro';
import type { PortfolioLevel } from '../../types/sanity';

interface Props {
  data: PortfolioLevel;
}

const { data } = Astro.props;
const projects = data.projects ?? [];
---

<section class="level portfolio" data-level="portfolio" id="portfolio">
  <div class="scroll-row portfolio-track" data-row="portfolio-row">
    {
      projects.map((project, i) => (
        <a
          class:list={['portfolio-item', `variant-${i % 4}`]}
          href={`/portfolio/${project.slug}/`}
        >
          <SanityImage
            image={project.cover}
            alt={project.title}
            sizes="(min-width: 768px) 26vw, 84vw"
            maxWidth={1080}
            class="portfolio-cover"
          />
          <span class="portfolio-item-title">{project.title}</span>
        </a>
      ))
    }
  </div>

  <ProgressDots rowId="portfolio-row" count={projects.length} />
</section>

<style>
  .portfolio {
    height: 100dvh;
  }

  .portfolio-track {
    height: 100%;
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: 1fr 1fr;
    align-items: start;
    column-gap: clamp(2rem, 6vw, 7rem);
    /* první sloupec projektů začíná ve středu stránky (jako intro ateliéru) */
    padding: calc(var(--header-height) + 2dvh) var(--page-pad) 6dvh 50vw;
  }

  .portfolio-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    scroll-margin-left: var(--page-pad);
  }

  .portfolio-item:hover {
    text-decoration: none;
  }

  .portfolio :global(.portfolio-cover) {
    width: auto;
    max-width: min(30vw, 560px);
    max-height: 34dvh;
  }

  .portfolio-item-title {
    font-size: var(--text-sm);
    line-height: 1.2;
  }

  /* střídavé offsety dle náhledu */
  .portfolio-item.variant-1 {
    margin-top: 4dvh;
  }

  .portfolio-item.variant-2 {
    margin-top: 9dvh;
  }

  .portfolio-item.variant-3 {
    margin-top: 6dvh;
  }

  @media (max-width: 767px) {
    .portfolio-track {
      grid-template-rows: 1fr;
      align-items: center;
      column-gap: var(--page-pad);
      padding-left: var(--page-pad);
    }

    .portfolio-item {
      width: calc(100vw - 2 * var(--page-pad));
      align-items: flex-start;
    }

    .portfolio :global(.portfolio-cover) {
      max-width: 100%;
      max-height: 62dvh;
    }

    .portfolio-item.variant-1,
    .portfolio-item.variant-2,
    .portfolio-item.variant-3 {
      margin-top: 0;
    }
  }
</style>
