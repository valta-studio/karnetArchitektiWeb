---
// Úroveň 3 — portfolio (dle náhledu): JEDNA řada fotek projektů ve smyčce,
// všechny ve stejné výšce (šířka z poměru stran), název pod fotkou na středu.
// Aktivní projekt je na středu obrazovky; sousední mají šedý název a čím
// dál od středu, tím víc blednou (data-row-distance nastavuje scroll-engine).
import ProgressDots from '../ProgressDots.astro';
import SanityImage from '../SanityImage.astro';
import {
  aspectRatioFor,
  PORTFOLIO_COVER_MAX_WIDTH,
  PORTFOLIO_COVER_SIZES,
} from '../../lib/image';
import type { PortfolioLevel } from '../../types/sanity';

interface Props {
  data: PortfolioLevel;
}

const { data } = Astro.props;
const projects = data.projects ?? [];
// nejširší fotka určuje na mobilu společnou výšku řady (musí se vejít na šířku)
const maxCoverRatio = Math.max(1, ...projects.map((project) => aspectRatioFor(project.cover)));
---

<section
  class="level portfolio"
  data-level="portfolio"
  id="portfolio"
  style={`--max-cover-ratio: ${maxCoverRatio.toFixed(4)}`}
>
  <div class="scroll-row portfolio-track" data-row="portfolio-row" data-loop>
    {
      projects.map((project) => (
        <a
          class="portfolio-item row-fade"
          href={`/portfolio/${project.slug}/`}
          style={`--cover-ratio: ${aspectRatioFor(project.cover).toFixed(4)}`}
          data-astro-prefetch="viewport"
        >
          <SanityImage
            image={project.cover}
            alt={project.title}
            sizes={PORTFOLIO_COVER_SIZES}
            maxWidth={PORTFOLIO_COVER_MAX_WIDTH}
            class="portfolio-cover"
          />
          <span class="portfolio-item-title">{project.title}</span>
        </a>
      ))
    }
  </div>

  <ProgressDots rowId="portfolio-row" count={projects.length} />
</section>

<style>
  .portfolio {
    height: 100svh;
  }

  .portfolio-track {
    height: 100%;
    align-items: center;
    /* fotka s názvem svisle na středu MEZI spodkem loga a tečkami
       (bottom --space-lg + výška tečky 4px), ne na středu celé obrazovky —
       padding posouvá content box, ve kterém flex centruje */
    padding-top: var(--header-bottom);
    padding-bottom: calc(var(--space-lg) + 4px);
    /* stejná mezera jako na ostatních drahách */
    gap: var(--page-pad);
  }

  /* projekt = snap cíl; center-snap → aktivní projekt ve středu.
     width: min-content → šířka položky = šířka fotky (název ji
     neovlivní, viz .portfolio-item-title). Spodní padding drží místo
     pro mezeru + jeden řádek názvu, takže všechny položky mají stejnou
     výšku jako fotka s jednořádkovým názvem a fotky v řadě lícují. */
  .portfolio-item {
    --title-gap: 0.9rem;
    --title-line: calc(var(--text-sm) * 1.2);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min-content;
    padding-bottom: calc(var(--title-gap) + var(--title-line));
    scroll-snap-align: center;
    transition: opacity 300ms var(--ease);
  }

  .portfolio-item:hover {
    text-decoration: none;
  }

  /* stejná výška všech fotek, šířka z přirozeného poměru stran —
     globální max-width: 100% by šířku ořízl a bitmapu roztáhl */
  .portfolio :global(.portfolio-cover) {
    width: auto;
    height: 36dvh;
    max-width: none;
  }

  /* Název na střed pod fotkou, nejvýš na šířku fotky — delší se zalomí
     (vyvážené řádky), aby nepřekrýval názvy sousedních projektů.
     Absolutně → šířku ani výšku položky neurčuje: další řádky jdou
     dolů do volného místa nad tečkami a fotka zůstává na místě. */
  .portfolio-item-title {
    position: absolute;
    top: calc(100% - var(--title-line));
    left: 0;
    right: 0;
    text-wrap: balance;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: 1.2;
    text-align: center;
    color: var(--color-muted);
    transition: color 300ms var(--ease);
  }

  /* vzdálenost od středu (0 = aktivní) */
  .portfolio-item[data-row-distance='0'] .portfolio-item-title {
    color: var(--color-text);
  }

  .portfolio-item[data-row-distance='1'] {
    opacity: 0.4;
  }

  .portfolio-item[data-row-distance='2'] {
    opacity: 0.3;
  }

  /* plynule podle polohy jako tlumení (.row-fade, scroll.css) */
  @supports (animation-timeline: view()) {
    .portfolio-item-title {
      transition: none;
      animation: title-tint linear both;
      animation-timeline: view(inline);
      animation-range:
        cover calc(50% - var(--row-step, 50vw))
        cover calc(50% + var(--row-step, 50vw));
    }
  }

  @keyframes title-tint {
    0%,
    100% {
      color: var(--color-muted);
    }

    50% {
      color: var(--color-text);
    }
  }

  @media (max-width: 767px) {
    /* tečky jsou na mobilu blíž spodnímu okraji (scroll.css) */
    .portfolio-track {
      padding-bottom: calc(var(--space-sm) + 4px);
    }

    /* všechny fotky stejně vysoké (jako na desktopu), nejvýš 32dvh;
       výšku omezuje i nejširší fotka řady, aby se vešla do 82vw.
       Šířka z poměru (--cover-ratio) funguje i před stažením obrázku
       (smyčka drah měří šířky hned) */
    .portfolio {
      --cover-height: min(32dvh, 82vw / var(--max-cover-ratio));
    }

    .portfolio :global(.portfolio-cover) {
      width: calc(var(--cover-height) * var(--cover-ratio));
      height: var(--cover-height);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-item,
    .portfolio-item-title {
      transition: none;
    }
  }
</style>
