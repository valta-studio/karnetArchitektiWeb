---
// Úroveň 3 — portfolio (dle náhledů): fotky projektů v přirozených proporcích,
// název pod fotkou. Vždy DVĚ řady, horizontální posun po stránkách.
// Snap jednotka = sloupec = dva projekty nad sebou (bez přesahů — každá fotka
// v jedné řadě, výška podle poměru stran).
// Desktop: obsah začíná ve vodorovném středu stránky (prázdno vlevo), dva
//   sloupce v šířce viewportu → 4 projekty na stránku (2×2).
// Mobil: jeden sloupec na obrazovku → 2 projekty na stránku (1×2).
import ProgressDots from '../ProgressDots.astro';
import SanityImage from '../SanityImage.astro';
import { aspectRatioFor } from '../../lib/image';
import type { PortfolioLevel, Project } from '../../types/sanity';

interface Props {
  data: PortfolioLevel;
}

const { data } = Astro.props;
const projects = data.projects ?? [];

type Item = {
  project: Project;
  shape: 'wide' | 'tall' | 'square';
};

const items: Item[] = projects.map((project) => {
  const ratio = project.cover ? aspectRatioFor(project.cover) : 1.5;
  const shape = ratio >= 1.15 ? 'wide' : ratio <= 0.87 ? 'tall' : 'square';
  return { project, shape };
});

// Dva projekty na sloupec (horní + spodní řada).
const columns: Item[][] = [];
for (let i = 0; i < items.length; i += 2) {
  columns.push(items.slice(i, i + 2));
}
---

<section class="level portfolio" data-level="portfolio" id="portfolio">
  <div class="scroll-row portfolio-track" data-row="portfolio-row">
    {
      columns.map((column) => (
        <div class="portfolio-col">
          {column.map(({ project, shape }) => (
            <a
              class:list={['portfolio-item', `is-${shape}`]}
              href={`/portfolio/${project.slug}/`}
              data-astro-prefetch="viewport"
            >
              <SanityImage
                image={project.cover}
                alt={project.title}
                sizes="(min-width: 768px) 32vw, 84vw"
                maxWidth={1200}
                class="portfolio-cover"
              />
              <span class="portfolio-item-title">{project.title}</span>
            </a>
          ))}
        </div>
      ))
    }
  </div>

  <ProgressDots rowId="portfolio-row" count={columns.length} />
</section>

<style>
  .portfolio {
    height: 100dvh;
  }

  .portfolio-track {
    height: 100%;
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
    /* desktop: první sloupec začíná ve vodorovném středu (prázdno vlevo);
       levý padding drží prostor, aby ho center-snap mohl vycentrovat */
    padding: calc(var(--header-height) + 2dvh) var(--page-pad) 6dvh 50vw;
  }

  /* sloupec = snap cíl, dvě řady nad sebou; center-snap → aktivní sloupec
     ve středu, sousední vykukují (vzhled dle náhledu) */
  .portfolio-col {
    display: grid;
    grid-template-rows: auto auto;
    align-content: center;
    row-gap: 4dvh;
    scroll-snap-align: center;
  }

  .portfolio-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    /* fotka si drží vlastní šířku z poměru stran (jinak by ji flex/grid
       roztáhl na šířku sloupce a při pevné výšce zdeformoval), vystředěná */
    align-items: center;
  }

  .portfolio-item:hover {
    text-decoration: none;
  }

  /* výška podle orientace, šířka vždy z přirozeného poměru stran —
     globální max-width: 100% by šířku ořízl podle gridu a bitmapu roztáhl */
  .portfolio :global(.portfolio-cover) {
    width: auto;
    height: 28dvh;
    max-width: none;
  }

  .portfolio-item.is-square :global(.portfolio-cover) {
    height: 32dvh;
  }

  .portfolio-item.is-tall :global(.portfolio-cover) {
    height: 38dvh;
  }

  .portfolio-item-title {
    font-size: var(--text-sm);
    line-height: 1.2;
  }

  @media (max-width: 767px) {
    .portfolio-track {
      gap: var(--page-pad);
      padding-left: var(--page-pad);
    }

    /* jeden sloupec na obrazovku → 2 projekty na stránku */
    .portfolio-col {
      width: calc(100vw - 2 * var(--page-pad));
    }

    .portfolio :global(.portfolio-cover) {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 36dvh;
    }

    .portfolio-item.is-tall :global(.portfolio-cover),
    .portfolio-item.is-square :global(.portfolio-cover) {
      max-height: 40dvh;
    }
  }
</style>
