---
// Úroveň 3 — portfolio (dle náhledu): JEDNA řada fotek projektů ve smyčce,
// všechny ve stejné výšce (šířka z poměru stran), název pod fotkou na středu.
// Aktivní projekt je na středu obrazovky; sousední mají šedý název a čím
// dál od středu, tím víc blednou (data-row-distance nastavuje scroll-engine).
import ProgressDots from '../ProgressDots.astro';
import SanityImage from '../SanityImage.astro';
import { aspectRatioFor } from '../../lib/image';
import type { PortfolioLevel } from '../../types/sanity';

interface Props {
  data: PortfolioLevel;
}

const { data } = Astro.props;
const projects = data.projects ?? [];
---

<section class="level portfolio" data-level="portfolio" id="portfolio">
  <div class="scroll-row portfolio-track" data-row="portfolio-row" data-loop>
    {
      projects.map((project) => (
        <a
          class="portfolio-item row-fade"
          href={`/portfolio/${project.slug}/`}
          style={`--cover-ratio: ${aspectRatioFor(project.cover).toFixed(4)}`}
          data-astro-prefetch="viewport"
        >
          <SanityImage
            image={project.cover}
            alt={project.title}
            sizes="(min-width: 768px) 50vw, 84vw"
            maxWidth={1600}
            class="portfolio-cover"
          />
          <span class="portfolio-item-title">{project.title}</span>
        </a>
      ))
    }
  </div>

  <ProgressDots rowId="portfolio-row" count={projects.length} />
</section>

<style>
  .portfolio {
    height: 100svh;
  }

  .portfolio-track {
    height: 100%;
    align-items: center;
    /* stejná mezera jako na ostatních drahách */
    gap: var(--page-pad);
  }

  /* projekt = snap cíl; center-snap → aktivní projekt ve středu.
     width: min-content → šířka položky = šířka fotky (název ji
     neovlivní, viz .portfolio-item-title) */
  .portfolio-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min-content;
    gap: 0.9rem;
    scroll-snap-align: center;
    transition: opacity 300ms var(--ease);
  }

  .portfolio-item:hover {
    text-decoration: none;
  }

  /* stejná výška všech fotek, šířka z přirozeného poměru stran —
     globální max-width: 100% by šířku ořízl a bitmapu roztáhl */
  .portfolio :global(.portfolio-cover) {
    width: auto;
    height: 36dvh;
    max-width: none;
  }

  /* Název vždy na jeden řádek a na střed pod fotkou, ale šířku položky
     neurčuje (mezery v řadě drží fotky): width 0 → do min-content šířky
     položky nepřispívá, min-width 100 % ho roztáhne na šířku fotky
     a delší text přesahuje rovnoměrně na obě strany (flex center) —
     zalomený název by navíc položku zvýšil a fotku posunul výš. */
  .portfolio-item-title {
    display: flex;
    justify-content: center;
    width: 0;
    min-width: 100%;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: 1.2;
    text-align: center;
    color: var(--color-muted);
    transition: color 300ms var(--ease);
  }

  /* vzdálenost od středu (0 = aktivní) */
  .portfolio-item[data-row-distance='0'] .portfolio-item-title {
    color: var(--color-text);
  }

  .portfolio-item[data-row-distance='1'] {
    opacity: 0.4;
  }

  .portfolio-item[data-row-distance='2'] {
    opacity: 0.3;
  }

  /* plynule podle polohy jako tlumení (.row-fade, scroll.css) */
  @supports (animation-timeline: view()) {
    .portfolio-item-title {
      transition: none;
      animation: title-tint linear both;
      animation-timeline: view(inline);
      animation-range:
        cover calc(50% - var(--row-step, 50vw))
        cover calc(50% + var(--row-step, 50vw));
    }
  }

  @keyframes title-tint {
    0%,
    100% {
      color: var(--color-muted);
    }

    50% {
      color: var(--color-text);
    }
  }

  @media (max-width: 767px) {
    /* jako fotky na kartě projektu: každá fotka v rámečku 32dvh × 82vw
       podle vlastního poměru stran — na šířku jsou nižší (nepřetečou
       displej), stejnou výšku mají jen fotky na výšku. Šířka z poměru
       (--cover-ratio) a výška dopočtená z width/height atributů funguje
       i před stažením obrázku (smyčka drah měří šířky hned) */
    .portfolio :global(.portfolio-cover) {
      width: min(82vw, 32dvh * var(--cover-ratio));
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-item,
    .portfolio-item-title {
      transition: none;
    }
  }
</style>
