---
// Úroveň 4 — kontakt (dle náhledů): jeden blok vlevo — e-mail a telefon,
// adresa kanceláře, sociální sítě pod sebou, fakturační údaje.
import type { Contact } from '../../types/sanity';

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;
const billing = contact.billing;
---

<section class="level kontakt" data-level="kontakt" id="kontakt">
  <div class="kontakt-block">
    <div class="kontakt-group">
      {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
      {
        contact.phone && (
          <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
        )
      }
    </div>

    {
      contact.address && (
        <div class="kontakt-group">
          <p>Kancelář:</p>
          <p class="pre-line">{contact.address}</p>
        </div>
      )
    }

    {
      contact.socialLinks?.length ? (
        <ul class="kontakt-group kontakt-socials">
          {contact.socialLinks.map((social) => (
            <li>
              <a href={social.url} rel="noopener" target="_blank">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }

    {
      billing && (billing.companyName || billing.registeredAddress) && (
        <div class="kontakt-group kontakt-billing">
          {billing.companyName && <p>{billing.companyName}</p>}
          {billing.registeredAddress && <p class="pre-line">{billing.registeredAddress}</p>}
        </div>
      )
    }

    {
      billing && (billing.ico || billing.dic) && (
        <div class="kontakt-group">
          {billing.ico && <p>IČO: {billing.ico}</p>}
          {billing.dic && <p>DIČ: {billing.dic}</p>}
        </div>
      )
    }
  </div>
</section>

<style>
  .kontakt {
    display: flex;
    align-items: center;
  }

  .kontakt-block {
    display: flex;
    flex-direction: column;
    gap: 1.2em;
    padding-inline: var(--page-pad);
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }

  .kontakt-group {
    display: flex;
    flex-direction: column;
  }

  .kontakt-group a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .kontakt-billing {
    margin-top: 1.2em;
  }

  .pre-line {
    white-space: pre-line;
  }
</style>
