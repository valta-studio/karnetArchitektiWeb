---
// Úroveň 4 — kontakt: jeden blok na středu — e-mail a telefon,
// adresa kanceláře, sociální sítě pod sebou, fakturační údaje.
// Na desktopu za blokem prosvítá úvodní médium stejně jako v ateliéru.
import SanityImage from '../SanityImage.astro';
import { INTRO_MEDIA_MAX_WIDTH, INTRO_MEDIA_SIZES, isMockImage, urlFor } from '../../lib/image';
import type { Contact, IntroLevel } from '../../types/sanity';

interface Props {
  contact: Contact;
  /** Úvodní médium — na desktopu prosvítá za kontakty (video, nebo foto). */
  intro?: IntroLevel;
}

const { contact, intro } = Astro.props;
const billing = contact.billing;

const backdropVideoSrc = intro?.videoFileUrl ?? intro?.videoUrl;
const backdropIsVideo = intro?.mode === 'video' && Boolean(backdropVideoSrc);
const backdropImage = intro?.photo ?? intro?.poster;

const backdropPosterUrl = intro?.poster
  ? isMockImage(intro.poster)
    ? intro.poster.src
    : urlFor(intro.poster).width(1200).url()
  : undefined;
---

<section class="level kontakt" data-level="kontakt" id="kontakt">
  {
    (backdropIsVideo || backdropImage) && (
      <div class="kontakt-backdrop" aria-hidden="true">
        {backdropIsVideo ? (
          /* Stejně jako v ateliéru: žádný druhý <video>, zrcadlíme snímky
             elementu z úrovně 1 do canvasu (viz scripts/video.ts). */
          <canvas
            data-intro-mirror
            style={backdropPosterUrl ? `background-image: url("${backdropPosterUrl}")` : undefined}
          />
        ) : (
          <SanityImage
            image={backdropImage!}
            alt=""
            sizes={INTRO_MEDIA_SIZES}
            maxWidth={INTRO_MEDIA_MAX_WIDTH}
          />
        )}
      </div>
    )
  }

  <div class="kontakt-block">
    <div class="kontakt-group">
      {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
      {
        contact.phone && (
          <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
        )
      }
    </div>

    {
      contact.address && (
        <div class="kontakt-group">
          <p>Kancelář:</p>
          <p class="pre-line">{contact.address}</p>
        </div>
      )
    }

    {
      contact.socialLinks?.length ? (
        <ul class="kontakt-group kontakt-socials">
          {contact.socialLinks.map((social) => (
            <li>
              <a href={social.url} rel="noopener" target="_blank">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }

    {
      billing && (billing.companyName || billing.registeredAddress) && (
        <div class="kontakt-group kontakt-billing">
          {billing.companyName && <p>{billing.companyName}</p>}
          {billing.registeredAddress && <p class="pre-line">{billing.registeredAddress}</p>}
        </div>
      )
    }

    {
      billing && (billing.ico || billing.dic) && (
        <div class="kontakt-group">
          {billing.ico && <p>IČO: {billing.ico}</p>}
          {billing.dic && <p>DIČ: {billing.dic}</p>}
        </div>
      )
    }
  </div>
</section>

<style>
  /* blok kontaktů vodorovně na středu (osa loga a menu) */
  .kontakt {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding-inline: var(--page-pad);
  }

  /* Podkres jen na desktopu — mobil zůstává bez média (viz náhledy).
     Skrytý canvas má nulovou velikost, video.ts ho pak vůbec neaktivuje. */
  .kontakt-backdrop {
    display: none;
  }

  @media (min-width: 768px) {
    .kontakt-backdrop {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      /* na středu pod hlavičkou, stejně jako médium v úvodu */
      padding-top: var(--header-bottom);
      pointer-events: none;
      opacity: 0.14;
      z-index: 1;
    }

    .kontakt-backdrop :global(img),
    .kontakt-backdrop :global(canvas) {
      /* Stejná geometrie jako médium v úvodu a podkres v ateliéru. */
      width: min(34vw, 560px);
      height: 72svh;
      object-fit: cover;
    }

    /* Poster pod zrcadlem — canvas je do prvního snímku průhledný. */
    .kontakt-backdrop :global(canvas) {
      background-position: center;
      background-size: cover;
    }
  }

  /* Vjezd z portfolia: médium NEJEDE spolu s úrovní — je fixované ve
     stabilním svh viewportu a scroll-driven animace ho proloží až po
     usazení úrovně. Obrácený průběh odjezdu ateliér → portfolio (tam
     0.14 → 0, tady 0 → 0.14). Bez podpory / s reduced-motion zůstává
     statický absolutní podkres výše. */
  @supports (animation-timeline: view()) {
    @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
      .kontakt {
        view-timeline: --kontakt block;
      }

      .kontakt-backdrop {
        position: fixed;
        inset: 0 auto auto 0;
        width: 100vw;
        height: 100svh;
        animation: kontakt-backdrop-reveal linear both;
        animation-timeline: --kontakt;
        animation-range: entry 0% entry 100%;
        will-change: opacity;
        backface-visibility: hidden;
      }
    }
  }

  /* Úroveň je vysoká přesně 100svh, takže entry 100% = okamžik dosnapování.
     První polovinu vjezdu je médium neviditelné, pak se proloží na 0.14. */
  @keyframes kontakt-backdrop-reveal {
    0%,
    50% {
      opacity: 0;
    }

    to {
      opacity: 0.14;
    }
  }

  .kontakt-block {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2em;
    text-align: center;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }

  .kontakt-group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .kontakt-group a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .kontakt-billing {
    margin-top: 1.2em;
  }

  .pre-line {
    white-space: pre-line;
  }

</style>
