---
// Hlavní stránka — úrovně 1–4 + burger obrazovka.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ScrollDeck from '../components/ScrollDeck.astro';
import LevelDots from '../components/LevelDots.astro';
import BurgerScreen from '../components/BurgerScreen.astro';
import IntroLevelComponent from '../components/levels/IntroLevel.astro';
import AtelierLevelComponent from '../components/levels/AtelierLevel.astro';
import PortfolioLevelComponent from '../components/levels/PortfolioLevel.astro';
import KontaktLevelComponent from '../components/levels/KontaktLevel.astro';
import {
  getAtelierLevel,
  getContact,
  getIntroLevel,
  getPortfolioLevel,
  getSeoSettings,
} from '../lib/sanity';
import { introPosterUrl, introVideoSrc } from '../lib/image';

const [intro, atelier, portfolio, contact, settings] = await Promise.all([
  getIntroLevel(),
  getAtelierLevel(),
  getPortfolioLevel(),
  getContact(),
  getSeoSettings(),
]);

// Poster úvodního videa je LCP úrovně 1 — preload scanner atribut `poster`
// nenajde, bez preloadu se stahuje až po vyparsování <video>.
const introPosterPreload = introVideoSrc(intro) ? introPosterUrl(intro) : undefined;
---

<Base isHome seo={intro.seo}>
  {
    introPosterPreload && (
      <link slot="head" rel="preload" as="image" href={introPosterPreload} fetchpriority="high" />
    )
  }
  <Header siteName={settings.siteName} />
  <LevelDots count={4} />

  <ScrollDeck menuAtEnd>
    <IntroLevelComponent data={intro} siteName={settings.siteName} />
    <AtelierLevelComponent data={atelier} intro={intro} />
    <PortfolioLevelComponent data={portfolio} />
    <KontaktLevelComponent contact={contact} intro={intro} />
    <BurgerScreen contact={contact} />
  </ScrollDeck>
</Base>
