# Sanity — web (Astro čte při buildu)
SANITY_PROJECT_ID=
SANITY_DATASET=

# Sanity — Studio (vyžaduje prefix SANITY_STUDIO_)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Netlify build hook VEŘEJNÉHO WEBU — tlačítko „Nasadit" ve Studiu jím spustí
# rebuild webu (ne Studia). Vezmi z Netlify webu s webem:
# Site configuration → Build & deploy → Build hooks
SANITY_STUDIO_NETLIFY_BUILD_HOOK=
